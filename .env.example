# Copie para .env e ajuste. O .env não é versionado.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Postgres. No Supabase: Project Settings > Database > Connection string > "Transaction pooler"
# (porta 6543). Em desenvolvimento, sem isto, usa postgres://postgres:postgres@localhost:5432/pataserotas.
DATABASE_URL=

# Segredo dos access tokens (HS256). Obrigatório em produção, mínimo 32 caracteres.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Duração dos tokens.
ACCESS_TOKEN_TTL_SEGUNDOS=3600
REFRESH_TOKEN_TTL_DIAS=30

# Origens liberadas no CORS, separadas por vírgula (o front Angular roda na 4200).
CORS_ORIGIN=http://localhost:4200

# Base do link enviado no e-mail de redefinição de senha.
FRONT_URL=http://localhost:4200

# Supabase Storage, para as fotos de perfil. Project Settings > API: "Project URL" e a chave
# "service_role" (secreta: só no servidor, nunca no front). Sem elas, as rotas de foto respondem 503.
# O bucket limita tamanho (25 MB) e tipo (image/*) na própria configuração dele.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_FOTOS=fotos_perfil
